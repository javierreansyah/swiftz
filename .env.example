# Required: TMDB v3 API key. Browser requests deliberately expose this value.
NEXT_PUBLIC_TMDB_API_KEY=your_tmdb_v3_api_key

# Required in production: your canonical origin, with protocol and no path.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Set in Vercel project settings to honor packageManager's pinned pnpm version.
ENABLE_EXPERIMENTAL_COREPACK=1

# Optional: a separate server-side TMDB v3 key (never shipped to the browser).
# TMDB_API_KEY=your_server_tmdb_v3_api_key
